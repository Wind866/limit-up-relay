# 复制为 .env 仅供本地参考；GitHub Actions 请把值填到仓库 Settings → Secrets and variables → Actions
# 注意：不要把真实 webhook / 密钥提交进仓库

# 飞书自定义机器人 webhook（必填才会推送；不填则只生成数据，不报错）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx

# 飞书机器人安全设置里的「加签」密钥（推荐开启；未开启则留空）
FEISHU_SECRET=

# 看板地址，用于卡片按钮跳转（Actions 中留空会自动推导 GitHub Pages 地址）
PAGES_URL=https://<owner>.github.io/<repo>/

# 仓库地址，用于「策略与部署说明」按钮
REPO_URL=https://github.com/<owner>/<repo>

# 演示数据强制推送（默认不推送演示数据，避免误导）
FORCE_PUSH=0
